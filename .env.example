# Required: bot token from https://discord.com/developers/applications
# Also enable "Message Content Intent" under Bot -> Privileged Gateway Intents.
DISCORD_TOKEN=your-bot-token-here

# Optional: your server ID, makes slash commands appear instantly (global sync can take up to an hour)
GUILD_ID=

# Optional: channel for daily posts (you can also run /setchannel in Discord)
DAILY_CHANNEL_ID=

# When to post each day (24h HH:MM) and in which timezone (IANA name, e.g. America/New_York)
POST_TIME=09:00
TIMEZONE=UTC

# Question of the Day category on boneitis.org (default: general)
QOTD_CATEGORY=general

# Puzzel.org Puzzle API (https://puzzel.org/en/developers/puzzle-api).
# Leave blank to skip the "Play on Puzzel" links; puzzles still work in Discord.
PUZZEL_API_KEY=
PUZZEL_EMAIL=
PUZZEL_LANGUAGE=en
# Only change these if Puzzel's docs list different endpoint paths
PUZZEL_BASE_URL=https://puzzel.org/api/public/v1
PUZZEL_CROSSWORD_PATH=crossword
PUZZEL_WORDSEARCH_PATH=wordseeker

# Where scores and progress are stored
DATA_FILE=data/state.json
